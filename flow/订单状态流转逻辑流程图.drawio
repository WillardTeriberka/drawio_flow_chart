        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph DAILY[\&quot;① 子订单状态任务：workOrderDailyStatusTask\&quot;]\n        D2[\&quot;2 已发布\&quot;] --&gt;|\&quot;招聘开始\&quot;| D3[\&quot;3 招聘中\&quot;]\n        D3 --&gt;|\&quot;招聘截止\&quot;| HAS{\&quot;整单有有效录用&lt;br/&gt;或已有开工及以后状态？\&quot;}\n\n        HAS --&gt;|\&quot;否\&quot;| WAIT[\&quot;保持 3&lt;br/&gt;清空 next_transition_time&lt;br/&gt;等待整单自动取消\&quot;]\n        HAS --&gt;|\&quot;是，包括其他日期有人\&quot;| D4[\&quot;4 待开工\&quot;]\n\n        D4 --&gt;|\&quot;计划开工时间到\&quot;| D5[\&quot;5 开工中\&quot;]\n        D5 --&gt;|\&quot;计划工作结束\&quot;| D6[\&quot;6 待结算\&quot;]\n        D6 --&gt;|\&quot;批次结算日已到\&quot;| D7[\&quot;7 结算中\&quot;]\n\n        D7 --&gt; CHECK{\&quot;最晚打卡时间已过&lt;br/&gt;应生成工资单无缺失&lt;br/&gt;没有未结算工资单？\&quot;}\n        CHECK --&gt;|\&quot;否\&quot;| KEEP7[\&quot;保持 7，后续继续检查\&quot;]\n        CHECK --&gt;|\&quot;是，无工资义务允许零工资单\&quot;| D8[\&quot;8 已完成\&quot;]\n\n        D8 --&gt; ALL{\&quot;全部工作日日单都是 8？\&quot;}\n        ALL --&gt;|\&quot;是\&quot;| SETTLED[\&quot;父订单：已结算&lt;br/&gt;此处不退资金、不退人次\&quot;]\n        ALL --&gt;|\&quot;否\&quot;| OTHER[\&quot;等待其他日期完成\&quot;]\n\n        D4 -.-&gt;|\&quot;开工前全员退出\&quot;| BUG[\&quot;当前漏洞：4 不进入无人保护&lt;br/&gt;状态任务先执行，仍按时间推进\&quot;]\n        BUG -.-&gt; D5\n\n        FINISH[\&quot;日状态处理后：finishDueItems&lt;br/&gt;日单为 6/7/8 且打卡窗口结束&lt;br/&gt;有效录用日抢单 → FINISHED\&quot;]\n    end\n\n    subgraph CANCEL[\&quot;② 整单自动取消任务：workOrderV2AutoCancelTask\&quot;]\n        C0[\&quot;扫描：父订单仍在招聘中&lt;br/&gt;招聘截止已过&lt;br/&gt;无待审核、审核通过的报名\&quot;]\n        C0 --&gt; C1{\&quot;锁内复核&lt;br/&gt;工作日日单均为 2/3/4&lt;br/&gt;无有效录用、无有效履约事实？\&quot;}\n        C1 --&gt;|\&quot;否\&quot;| SKIP[\&quot;本轮不取消\&quot;]\n        C1 --&gt;|\&quot;是\&quot;| CANCELLED[\&quot;取消事务&lt;br/&gt;父订单 → 已取消&lt;br/&gt;工作日日单 → 9 已关闭&lt;br/&gt;取消相关有效抢单，返还人次\&quot;]\n        CANCELLED --&gt; INS{\&quot;需要等待保险处理？\&quot;}\n        INS --&gt;|\&quot;否\&quot;| DIRECT[\&quot;取消事务返还剩余冻结资金&lt;br/&gt;冻结池 → CLOSED\&quot;]\n        INS --&gt;|\&quot;是\&quot;| CLOSING[\&quot;冻结池 → CLOSING&lt;br/&gt;资金等待后续关池\&quot;]\n    end\n\n    subgraph POOL[\&quot;③ 关池任务：orderFreezePoolCloseTask\&quot;]\n        NORMAL[\&quot;正常完成候选&lt;br/&gt;父订单已结算&lt;br/&gt;池为 OPEN/CLOSING&lt;br/&gt;超过最后打卡时间\&quot;]\n        NORMAL --&gt; VALID{\&quot;保险、资金完整性通过&lt;br/&gt;全部工作日日单为 8&lt;br/&gt;工资与实际人次校验通过？\&quot;}\n        VALID --&gt;|\&quot;是\&quot;| RETURN[\&quot;返还剩余人次、剩余冻结资金&lt;br/&gt;冻结池 → CLOSED\&quot;]\n        VALID --&gt;|\&quot;否\&quot;| BLOCK[\&quot;本轮关池失败或等待&lt;br/&gt;资金和人次不返还\&quot;]\n\n        CC[\&quot;取消候选&lt;br/&gt;父订单已取消且池为 CLOSING\&quot;]\n        CC --&gt; CV{\&quot;保险及资金校验通过？\&quot;}\n        CV --&gt;|\&quot;否\&quot;| CW[\&quot;保持 CLOSING，后续重试\&quot;]\n        CV --&gt;|\&quot;是\&quot;| CR[\&quot;返还剩余冻结资金&lt;br/&gt;冻结池 → CLOSED&lt;br/&gt;不重复返还取消时已退的人次\&quot;]\n    end\n\n    WAIT -.-&gt; C0\n    D4 -.-&gt;|\&quot;自动取消先执行且满足条件\&quot;| C0\n    SETTLED -.-&gt; NORMAL\n    CLOSING -.-&gt; CC\n    BUG -.-&gt;|\&quot;失去自动取消资格；最终整单零工资单\&quot;| BLOCK\n\n    classDef danger fill:#fee2e2,stroke:#dc2626,color:#991b1b;\n    classDef success fill:#dcfce7,stroke:#16a34a,color:#166534;\n    class BUG,BLOCK danger;\n    class RETURN,DIRECT,CR success;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hmApGhrk1UctMuSjGIT0-1">
