        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    EP_WORK_ORDER {\n        bigint id PK\n        varchar order_num UK\n        varchar settlement_type\n        tinyint settlement_day\n        json rest_dates\n        bigint rest_days\n    }\n\n    EP_BIDDING {\n        bigint id PK\n        bigint order_id FK\n        bigint personnel_id\n    }\n\n    EP_ATTENDANCE_RECORD {\n        bigint id PK\n        bigint order_id FK\n        bigint bidding_id FK\n        date work_date\n        int clock_num\n    }\n\n    EP_SETTLEMENT_BATCH {\n        bigint id PK\n        varchar settlement_batch_num UK\n        bigint order_id FK\n        int batch_seq\n        date period_start_date\n        date period_end_date\n        date settlement_date\n        int last_settlement_record_seq\n        varchar source_type\n    }\n\n    EP_DAILY_SALARY {\n        bigint id PK\n        bigint order_id FK\n        bigint bidding_id FK\n        bigint personnel_id\n        date work_date\n        bigint settlement_batch_id FK\n        bigint processing_record_id\n        bigint settlement_record_id FK\n        decimal gross_income_amount\n        decimal total_deduction_amount\n        decimal net_salary_amount\n        decimal total_settlement_amount\n        varchar salary_status\n        varchar source_type\n        bigint legacy_settlement_group_id\n        decimal migration_difference_amount\n    }\n\n    EP_SETTLEMENT_RECORD {\n        bigint id PK\n        varchar settlement_record_num UK\n        bigint settlement_batch_id FK\n        int settlement_record_seq\n        bigint order_id\n        bigint channel_id\n        bigint service_id\n        int personnel_count\n        int daily_salary_count\n        decimal net_salary_amount\n        decimal tax_amount\n        decimal service_fee_amount\n        decimal total_settlement_amount\n        varchar status\n        varchar added_tax_invoice_num\n        varchar diff_tax_invoice_num\n        varchar source_type\n        varchar migration_status\n        varchar legacy_funds_settlement_num\n        varchar legacy_ep_settlement_num\n    }\n\n    EP_SETTLEMENT_RECORD_DAILY_SALARY {\n        bigint id PK\n        bigint settlement_record_id FK\n        bigint daily_salary_id FK\n        bigint personnel_id\n        decimal net_salary_amount_snapshot\n        decimal total_settlement_amount_snapshot\n        varchar relation_status\n        json finance_snapshot_json\n    }\n\n    EP_PERSONAL_SETTLEMENT {\n        bigint id PK\n        varchar personal_settlement_num UK\n        bigint settlement_record_id FK\n        bigint settlement_batch_id FK\n        bigint order_id\n        bigint personnel_id\n        varchar personnel_num\n        decimal net_salary_amount\n        decimal tax_amount\n        decimal service_fee_amount\n        decimal total_settlement_amount\n        varchar status\n        varchar source_type\n        bigint legacy_settlement_order_id\n        varchar legacy_settle_num\n        varchar legacy_funds_settlement_num\n    }\n\n    EP_WITHDRAWAL_MAIN {\n        bigint id PK\n        varchar withdrawal_num UK\n        bigint personnel_id\n        decimal amount\n        varchar withdrawal_status\n    }\n\n    EP_WITHDRAWAL_DETAIL {\n        bigint detail_id PK\n        bigint main_id FK\n        bigint personal_settlement_id FK\n        varchar personal_settlement_num\n        decimal settle_amount\n        varchar arrival_status\n    }\n\n    EP_APPEAL_RECORD {\n        bigint id PK\n        varchar appeal_type\n        bigint daily_salary_id FK\n        bigint personal_settlement_id FK\n        date work_date\n        varchar appeal_status\n    }\n\n    T_INVOICE {\n        bigint id PK\n        varchar invoice_num UK\n        varchar settlement_ids\n        decimal actual_salary\n        decimal insurance_fee\n        decimal service_fee_include_tax\n        int audit_status\n    }\n\n    T_TENANT_ACCOUNT {\n        bigint id PK\n        bigint channel_id\n        bigint service_id\n        decimal total_settlement_unreported_vats\n        decimal total_settlement_reported_vats\n        decimal total_settlement_unreported_vato\n        decimal total_settlement_reported_vato\n        decimal total_settlement_unreported_vdto\n        decimal total_settlement_reported_vdto\n        decimal total_settlement_unreported_vdts\n        decimal total_settlement_reported_vdts\n    }\n\n    EP_SETTLEMENT_ORDER {\n        bigint id PK\n        varchar settle_num UK\n        bigint order_id\n        bigint bidding_id\n        decimal salary_settle\n        varchar status\n    }\n\n    T_SETTLEMENT {\n        bigint id PK\n        varchar settlement_num UK\n        varchar ep_settlement_num\n        bigint ep_work_order_id\n        bigint personnel_id\n        decimal actual_salary\n        decimal total_amount\n        int status\n    }\n\n    EP_WORK_ORDER ||--o{ EP_BIDDING : \&quot;产生抢单\&quot;\n    EP_BIDDING ||--o{ EP_ATTENDANCE_RECORD : \&quot;生成考勤\&quot;\n\n    EP_WORK_ORDER ||--|{ EP_SETTLEMENT_BATCH : \&quot;创建时预生成\&quot;\n    EP_SETTLEMENT_BATCH ||--o{ EP_DAILY_SALARY : \&quot;工资单归属\&quot;\n    EP_BIDDING ||--o{ EP_DAILY_SALARY : \&quot;按work_date聚合\&quot;\n\n    EP_SETTLEMENT_BATCH ||--o{ EP_SETTLEMENT_RECORD : \&quot;允许多次结算\&quot;\n    EP_SETTLEMENT_RECORD ||--o{ EP_SETTLEMENT_RECORD_DAILY_SALARY : \&quot;保存每次勾选快照\&quot;\n    EP_DAILY_SALARY ||--o{ EP_SETTLEMENT_RECORD_DAILY_SALARY : \&quot;允许失败后再次勾选\&quot;\n\n    EP_SETTLEMENT_RECORD ||--o{ EP_PERSONAL_SETTLEMENT : \&quot;成功后按人员分组\&quot;\n    EP_PERSONAL_SETTLEMENT ||--o{ EP_WITHDRAWAL_DETAIL : \&quot;允许失败后重新提现\&quot;\n    EP_WITHDRAWAL_MAIN ||--|{ EP_WITHDRAWAL_DETAIL : \&quot;一次申请包含多条明细\&quot;\n\n    EP_DAILY_SALARY ||--o{ EP_APPEAL_RECORD : \&quot;考勤或追加申诉\&quot;\n    EP_PERSONAL_SETTLEMENT ||--o{ EP_APPEAL_RECORD : \&quot;提现申诉\&quot;\n\n    T_INVOICE o|..o{ EP_SETTLEMENT_RECORD : \&quot;settlement_ids逻辑关联\&quot;\n    T_TENANT_ACCOUNT o|..o{ EP_SETTLEMENT_RECORD : \&quot;成功结算累加未报金额\&quot;\n\n    EP_WORK_ORDER ||..o{ EP_SETTLEMENT_ORDER : \&quot;LEGACY旧结算单\&quot;\n    EP_SETTLEMENT_ORDER o|..o{ EP_DAILY_SALARY : \&quot;LEGACY按work_date拆分\&quot;\n    EP_SETTLEMENT_ORDER o|..o{ T_SETTLEMENT : \&quot;旧编号关联\&quot;\n    T_SETTLEMENT ||..|| EP_SETTLEMENT_RECORD : \&quot;保留主键逐条迁移\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3N9jXjo8txI8Hejmz1Qx-16">
