        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    A[\&quot;创建或发布V2订单\&quot;] --&gt; B[\&quot;按日结/周结/月结预生成结算批次\&quot;]\n    A --&gt; C{\&quot;是否休息日\&quot;}\n    C -- \&quot;是\&quot; --&gt; C1[\&quot;不生成排班考勤，不允许参与该日期\&quot;]\n    C -- \&quot;否\&quot; --&gt; D[\&quot;生成排班与考勤记录\&quot;]\n\n    D --&gt; E{\&quot;最后一次下班打卡完成？\&quot;}\n    E -- \&quot;是\&quot; --&gt; F[\&quot;RocketMQ生成日工资单\&quot;]\n    E -- \&quot;超出可打卡时间\&quot; --&gt; G[\&quot;10分钟补偿任务生成\&quot;]\n    F --&gt; H[\&quot;order+bidding+work_date唯一工资单\&quot;]\n    G --&gt; H\n\n    H --&gt; I[\&quot;零工确认或超时自动确认\&quot;]\n    I --&gt; J{\&quot;存在未终态考勤/追加申诉？\&quot;}\n    J -- \&quot;是\&quot; --&gt; K[\&quot;禁止确认和结算\&quot;]\n    J -- \&quot;否\&quot; --&gt; L[\&quot;工资单进入待结算\&quot;]\n\n    L --&gt; M[\&quot;企业在单个批次勾选工资单\&quot;]\n    M --&gt; N{\&quot;每名零工勾选工资合计&gt;0？\&quot;}\n    N -- \&quot;否\&quot; --&gt; N1[\&quot;整次拒绝，不生成结算次数\&quot;]\n    N -- \&quot;是\&quot; --&gt; O[\&quot;生成PROCESSING结算次数并占用工资单\&quot;]\n    O --&gt; P[\&quot;写入结算次数—工资单勾选快照\&quot;]\n    P --&gt; Q[\&quot;调用Funds，幂等号=结算次数编号\&quot;]\n\n    Q --&gt; R{\&quot;资金结果\&quot;}\n    R -- \&quot;明确失败\&quot; --&gt; S[\&quot;结算次数FAILED，序号保留\&quot;]\n    S --&gt; S1[\&quot;释放工资单占用，可使用新次数重试\&quot;]\n\n    R -- \&quot;未知\&quot; --&gt; T[\&quot;保持PROCESSING\&quot;]\n    T --&gt; T1[\&quot;按原编号查询资金流水并补偿\&quot;]\n    T1 --&gt; R\n\n    R -- \&quot;成功\&quot; --&gt; U[\&quot;结算次数SUCCESS\&quot;]\n    U --&gt; V[\&quot;工资单写成功次数编号并改为已结算\&quot;]\n    U --&gt; W[\&quot;首次成功时解冻整个订单冻结金额\&quot;]\n    U --&gt; X[\&quot;按人员汇总生成个人结算记录\&quot;]\n    U --&gt; Y[\&quot;Funds累加对应未报开票金额\&quot;]\n\n    X --&gt; Z[\&quot;零工选择一个或多个个人结算记录提现\&quot;]\n    Z --&gt; Z1[\&quot;一条提现主单\&quot;]\n    Z1 --&gt; Z2[\&quot;每个个人结算记录生成一条提现明细\&quot;]\n    Z2 --&gt; Z3[\&quot;提现中/已提现状态回写个人记录及工资单\&quot;]\n\n    U --&gt; IA[\&quot;System通过Employ Feign选择可开票结算次数\&quot;]\n    IA --&gt; IB[\&quot;t_invoice.settlement_ids保存结算次数ID\&quot;]\n    IB --&gt; IC[\&quot;未报累计转为已报累计\&quot;]\n    IC --&gt; ID{\&quot;发票撤销或驳回\&quot;}\n    ID -- \&quot;是\&quot; --&gt; IE[\&quot;释放发票号，已报累计转回未报\&quot;]\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3N9jXjo8txI8Hejmz1Qx-579">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
